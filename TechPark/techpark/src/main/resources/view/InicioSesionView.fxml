<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="450.0" prefWidth="400.0" 
      style="-fx-background-color: #f4f4f9; -fx-padding: 40;" 
      xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="co.edu.uniquindio.techpark.viewcontroller.InicioSesionViewController">
   
   <children>
      <VBox alignment="TOP_CENTER" spacing="15.0" 
            style="-fx-background-color: #ffffff; -fx-padding: 30; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 15, 0, 0, 0);" 
            VBox.vgrow="NEVER">
         
         <children>
            <VBox alignment="CENTER" spacing="5.0">
               <children>
                  <Label text="TechPark" textFill="#2c3e50">
                     <font>
                        <Font name="System Bold" size="28.0" />
                     </font>
                  </Label>
                  <Label text="Ingresa tus credenciales" textFill="#7f8c8d">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Label>
               </children>
               <VBox.margin>
                  <Insets bottom="15.0" />
               </VBox.margin>
            </VBox>

            <VBox spacing="5.0">
               <children>
                  <Label text="Número de Documento" textFill="#34495e">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtDocumento" prefHeight="35.0" promptText="Ej. 1094888XXX" 
                             style="-fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-background-color: #ffffff;" />
               </children>
            </VBox>

            <VBox spacing="5.0">
               <children>
                  <Label text="Contraseña" textFill="#34495e">
                     <font>
                        <Font name="System Bold" size="12.0" />
                     </font>
                  </Label>
                  <PasswordField fx:id="txtContrasenia" prefHeight="35.0" promptText="••••••••••••" 
                                 style="-fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-background-color: #ffffff;" />
               </children>
            </VBox>

            <Label fx:id="lblError" alignment="CENTER" maxWidth="1.1797693134862315E308" text="Documento o contraseña incorrectos" textFill="#e74c3c" wrapText="true">
               <font>
                  <Font name="System Italic" size="12.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="5.0" top="5.0" />
               </VBox.margin>
            </Label>

            <Button fx:id="btnIniciarSesion" maxWidth="1.1797693134862315E308" mnemonicParsing="false" onAction="#onIniciarSesion" prefHeight="38.0" 
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="Iniciar Sesión">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>

            <Hyperlink fx:id="lnkRegistro" onAction="#onIrARegistro" text="¿No tienes cuenta? Regístrate aquí" textFill="#2980b9">
               <font>
                  <Font size="12.0" />
               </font>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </Hyperlink>
         </children>
      </VBox>
   </children>
</VBox>