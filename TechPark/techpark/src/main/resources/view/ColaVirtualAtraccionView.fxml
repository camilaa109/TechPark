<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="20.0" prefWidth="500.0" prefHeight="620.0"
      style="-fx-background-color: #f4f4f9; -fx-padding: 30;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.techpark.viewcontroller.ColaVirtualAtraccionViewController">
   
   <children>
      <VBox alignment="CENTER" spacing="5.0">
         <children>
            <Label text="Cola Virtual de Atracciones" textFill="#2c3e50">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>
            <Label text="Consulta tiempos de espera y asegura tu lugar" textFill="#7f8c8d">
               <font>
                  <Font size="14.0" />
               </font>
            </Label>
         </children>
         <VBox.margin>
            <Insets bottom="10.0" />
         </VBox.margin>
      </VBox>

      <GridPane hgap="15.0" vgap="15.0" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="30.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="70.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="Seleccionar Zona:" textFill="#34495e" GridPane.columnIndex="0">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <ComboBox fx:id="comboZona" maxWidth="1.1797693134862315E308" promptText="-- Elija una Zona --" style="-fx-background-radius: 5;" GridPane.columnIndex="1" />
            
            <Label text="Atracción:" textFill="#34495e" GridPane.rowIndex="1">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Label>
            <ComboBox fx:id="comboAtraccion" maxWidth="1.1797693134862315E308" promptText="-- Elija una Atracción --" style="-fx-background-radius: 5;" GridPane.columnIndex="1" GridPane.rowIndex="1" />
         </children>
      </GridPane>

      <VBox spacing="12.0" style="-fx-background-color: #eef2f3; -fx-padding: 15; -fx-background-radius: 8;" VBox.vgrow="ALWAYS">
         <children>
            <Label fx:id="lblTiempoEspera" text="Tiempo estimado de espera: --" textFill="#2c3e50">
               <font><Font size="14.0" /></font>
            </Label>
            <Label fx:id="lblEstadoAcceso" text="Esperando selección..." textFill="#36494b">
               <font><Font name="System Italic" size="14.0" /></font>
            </Label>

            <Label fx:id="lblTituloCola" text="Cola Virtual" textFill="#2c3e50" managed="false" visible="false">
               <font><Font name="System Bold" size="13.0" /></font>
               <VBox.margin><Insets top="8.0" /></VBox.margin>
            </Label>
            <Label fx:id="lblTamanioCola" text="" textFill="#95a5a6" managed="false" visible="false">
               <font><Font size="11.0" /></font>
            </Label>
            <ListView fx:id="listViewCola" prefHeight="150.0" managed="false" visible="false"
                      style="-fx-background-radius: 5; -fx-border-color: #dcdde1; -fx-border-radius: 5;"
                      VBox.vgrow="ALWAYS" />
         </children>
      </VBox>

      <HBox alignment="CENTER" spacing="15.0">
         <children>
            <Button fx:id="btnVolver" mnemonicParsing="false" onAction="#onVolver" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="Volver">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Button>
            
            <Button fx:id="btnConsultarTiempo" mnemonicParsing="false" onAction="#onConsultarTiempoEspera" prefHeight="35.0" prefWidth="150.0" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="Consultar Tiempo">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Button>
            
            <Button fx:id="btnUnirseACola" mnemonicParsing="false" onAction="#onUnirseACola" prefHeight="35.0" prefWidth="150.0" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="Unirse a la Cola">
               <font>
                  <Font name="System Bold" size="13.0" />
               </font>
            </Button>
         </children>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </HBox>
   </children>
</VBox>