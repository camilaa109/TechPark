<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="550.0" prefWidth="500.0" 
      style="-fx-background-color: #f4f4f9; -fx-padding: 30;" 
      xmlns="http://javafx.com/javafx/21" 
      xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="co.edu.uniquindio.techpark.viewcontroller.RegistroVisitanteViewController">
   
   <children>
      <VBox alignment="TOP_CENTER" spacing="20.0" 
            style="-fx-background-color: #ffffff; -fx-padding: 30; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 15, 0, 0, 0);" 
            VBox.vgrow="NEVER">
         
         <children>
            <VBox alignment="CENTER" spacing="5.0">
               <children>
                  <Label text="Crear Cuenta" textFill="#2c3e50">
                     <font>
                        <Font name="System Bold" size="26.0" />
                     </font>
                  </Label>
                  <Label text="Regístrate como Visitante para ingresar al parque" textFill="#7f8c8d">
                     <font>
                        <Font size="13.0" />
                     </font>
                  </Label>
               </children>
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </VBox>

            <GridPane hgap="15.0" vgap="15.0">
              <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="50.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="50.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints minHeight="10.0" prefHeight="60.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="60.0" vgrow="SOMETIMES" />
                <RowConstraints minHeight="10.0" prefHeight="60.0" vgrow="SOMETIMES" />
              </rowConstraints>
               <children>
                  
                  <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                     <children>
                        <Label text="Nombre Completo" textFill="#34495e">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtNombre" prefHeight="35.0" promptText="Ej. Juan Pérez" 
                                   style="-fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5;" />
                     </children>
                  </VBox>
                  
                  <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                     <children>
                        <Label text="Número de Documento" textFill="#34495e">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtDocumento" prefHeight="35.0" promptText="Ej. 1094XXXXXX" 
                                   style="-fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5;" />
                     </children>
                  </VBox>
                  
                  <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                     <children>
                        <Label text="Edad" textFill="#34495e">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtEdad" prefHeight="35.0" promptText="Ej. 20" 
                                   style="-fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5;" />
                     </children>
                  </VBox>
                  
                  <VBox spacing="5.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                     <children>
                        <Label text="Estatura (metros)" textFill="#34495e">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <TextField fx:id="txtEstatura" prefHeight="35.0" promptText="Ej. 1.75" 
                                   style="-fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5;" />
                     </children>
                  </VBox>
                  
                  <VBox spacing="5.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="2">
                     <children>
                        <Label text="Contraseña de Acceso" textFill="#34495e">
                           <font>
                              <Font name="System Bold" size="12.0" />
                           </font>
                        </Label>
                        <PasswordField fx:id="txtContrasenia" prefHeight="35.0" promptText="Crea una contraseña segura" 
                                       style="-fx-background-radius: 5; -fx-border-color: #bdc3c7; -fx-border-radius: 5;" />
                     </children>
                  </VBox>
               </children>
            </GridPane>

            <VBox alignment="CENTER" spacing="12.0">
               <children>
                  <Button fx:id="btnRegistrar" maxWidth="1.1797693134862315E308" mnemonicParsing="false" onAction="#onRegistrar" prefHeight="40.0" 
                          style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="Registrarse">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                     <VBox.margin>
                        <Insets top="10.0" />
                     </VBox.margin>
                  </Button>
                  
                  <Hyperlink fx:id="lnkVolver" onAction="#onVolver" text="¿Ya tienes cuenta? Inicia Sesión" textFill="#2980b9">
                     <font>
                        <Font size="12.0" />
                     </font>
                  </Hyperlink>
               </children>
            </VBox>
         </children>
      </VBox>
   </children>
</VBox>