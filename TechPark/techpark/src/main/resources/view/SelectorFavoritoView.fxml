<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="20.0" prefWidth="460.0" prefHeight="340.0"
      style="-fx-background-color: #f4f4f9; -fx-padding: 30;"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="co.edu.uniquindio.techpark.viewcontroller.SelectorFavoritoViewController">
   <children>

      <!-- ENCABEZADO -->
      <VBox alignment="CENTER" spacing="5.0">
         <children>
            <Label text="Agregar Favorito" textFill="#2c3e50">
               <font><Font name="System Bold" size="22.0" /></font>
            </Label>
            <Label text="Selecciona la atracción que deseas seguir" textFill="#7f8c8d">
               <font><Font size="13.0" /></font>
            </Label>
         </children>
         <VBox.margin><Insets bottom="10.0" /></VBox.margin>
      </VBox>

      <!-- SELECTORES -->
      <GridPane hgap="15.0" vgap="15.0"
                style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 8;
                       -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
         <columnConstraints>
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="35.0" />
            <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" percentWidth="65.0" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
            <RowConstraints minHeight="10.0" prefHeight="40.0" vgrow="SOMETIMES" />
         </rowConstraints>
         <children>
            <Label text="Zona:" textFill="#34495e" GridPane.columnIndex="0">
               <font><Font name="System Bold" size="13.0" /></font>
            </Label>
            <ComboBox fx:id="comboZona" maxWidth="1.7976931348623157E308"
                      promptText="-- Elija una Zona --"
                      style="-fx-background-radius: 5;"
                      GridPane.columnIndex="1" />

            <Label text="Atracción:" textFill="#34495e" GridPane.rowIndex="1">
               <font><Font name="System Bold" size="13.0" /></font>
            </Label>
            <ComboBox fx:id="comboAtraccion" maxWidth="1.7976931348623157E308"
                      promptText="-- Elija una Atracción --"
                      style="-fx-background-radius: 5;"
                      GridPane.columnIndex="1" GridPane.rowIndex="1" />
         </children>
      </GridPane>

      <!-- BOTONES -->
      <HBox alignment="CENTER" spacing="15.0">
         <children>
            <Button fx:id="btnCancelar" onAction="#onCancelar"
                    prefHeight="35.0" prefWidth="110.0"
                    style="-fx-background-color: #95a5a6; -fx-text-fill: white;
                           -fx-background-radius: 5; -fx-cursor: hand;" text="Cancelar">
               <font><Font name="System Bold" size="13.0" /></font>
            </Button>
            <Button fx:id="btnConfirmar" onAction="#onConfirmar"
                    prefHeight="35.0" prefWidth="160.0"
                    style="-fx-background-color: #f39c12; -fx-text-fill: white;
                           -fx-background-radius: 5; -fx-cursor: hand;" text="⭐ Agregar Favorito">
               <font><Font name="System Bold" size="13.0" /></font>
            </Button>
         </children>
         <VBox.margin><Insets top="10.0" /></VBox.margin>
      </HBox>

   </children>
</VBox>
